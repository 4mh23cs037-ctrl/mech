{
  "name": "mit-mysore-3d-printing-portal",
  "version": "1.0.0",
  "description": "Additive Manufacturing & 3D Printing Portal for MIT Mysore - Dept of Mechanical Engineering",
  "scripts": {
    "server": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
